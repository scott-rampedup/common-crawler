# Copy to .env for local use, or set these in your host's dashboard.
# Do NOT commit a real .env (it's gitignored).

# Connect to real Common Crawl (false) vs offline mock data (true)
DEMO_MODE=false

# Where job data is stored. On a host, point this at a persistent disk.
# Locally you can leave it unset (defaults to the app folder).
# DATA_DIR=/var/data

# Access control — set ONE of these so the app isn't open to the world.
#   Shared password (any username works):
APP_PASSWORD=change-me-to-a-long-random-password
#   OR specific logins (comma-separated user:password pairs):
# AUTH_USERS=alice:pw-alice,bob:pw-bob

# Port is usually injected by the host; locally defaults to 3000.
# PORT=3000

# Outbound proxy for LIVE page fetches — needed for sites behind bot protection
# (Akamai/Cloudflare, e.g. howardhanna.com) that 403 a datacenter IP. Use a RESIDENTIAL
# rotating gateway (a datacenter proxy will still be blocked). The engine rolls a fresh
# exit IP on each blocked retry, so use a per-request rotating endpoint.
# Format: PROXY_URL=http://USER:PASS@GATEWAY:PORT   (provider examples — pick ONE)
#   NetNut residential : http://USER-res-any:PASS@gw.netnut.net:5959
#   Bright Data resi   : http://brd-customer-XXXX-zone-residential:PASS@brd.superproxy.io:33335
#   Oxylabs resi       : http://customer-USER:PASS@pr.oxylabs.io:7777
#   Decodo/Smartproxy  : http://USER:PASS@gate.decodo.com:7000
# Tiers are escalated cheapest-first by liveFetchPage; a tier is tried only when the
# previous one is BLOCKED:
#   PROXY_URL          primary — cheap datacenter gateway
#   PROXY_FALLBACK_URL residential — for sites that block datacenter IPs
#   UNBLOCKER_API_URL  website-unblocker API — runs a real browser to solve JS/TLS
#                      challenges (Akamai/Cloudflare-JS, e.g. howardhanna.com). NetNut's is an
#                      HTTP API (POST {url,format:html}), NOT a proxy — slow (~60-90s/page) +
#                      billed per request, so it fires LAST and only on still-blocked pages.
#                      Enable "Website Unblocker" in NetNut and use its /unblock endpoint:
#                      https://USER:PASS@unblocker.netnut.io/unblock
# Verify:  PROXY_URL=... PROXY_FALLBACK_URL=... UNBLOCKER_API_URL=... node cc-engine.js --proxy-test
# PROXY_URL=http://user:pass@gateway:port
# PROXY_FALLBACK_URL=http://user:pass@residential-gateway:port
# UNBLOCKER_API_URL=https://user:pass@unblocker.netnut.io/unblock
