{
  "name": "rampedup-phase1-ui",
  "version": "0.1.0",
  "description": "Common Crawl + live-crawl contact extraction with a job dashboard.",
  "main": "ui-server.js",
  "scripts": {
    "start": "node ui-server.js",
    "demo:win": "set DEMO_MODE=true&& node ui-server.js",
    "demo": "DEMO_MODE=true node ui-server.js",
    "selftest": "node cc-engine.js --selftest",
    "selftest:apis": "node site-apis.js --selftest",
    "selftest:vcard": "node vcard.js --selftest",
    "selftest:blocks": "node wireless-block-classifier.js",
    "selftest:normalize": "node normalize.js --selftest",
    "selftest:miner": "node cc-domain-miner.js --selftest",
    "selftest:athena": "node cc-athena-miner.js --selftest",
    "selftest:loader": "node load-bio-urls.js --selftest"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "google-libphonenumber": "^3.2.44",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "libphonenumber-geo-carrier": "^2.0.0",
    "nodemailer": "^9.0.0"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-athena": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-sts": "^3.1075.0"
  }
}
